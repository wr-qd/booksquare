# Flask配置
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# 数据库配置
DATABASE_URL=mysql+mysqlconnector://root:20040826Zjy!!!@localhost/book_review_system

# 邮件配置 - 请填写你的邮箱信息
# 如果使用Gmail，需要开启"允许不够安全的应用"或使用应用专用密码
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# 其他配置
FLASK_ENV=development

# （可选）豆瓣 Cookie（用于降低搜索/详情请求的 403 风控概率）
# 取值为浏览器请求头里的 Cookie 整段字符串，例如："a=1; b=2; ..."
DOUBAN_COOKIE=
