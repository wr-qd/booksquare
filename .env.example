# 应用配置
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# 数据库配置
# 默认后端使用 SQLite（无需额外安装数据库）：
# DATABASE_URL=sqlite:///C:/path/to/book_review.db
# 如需使用 MySQL（需要安装 MySQL 并创建数据库）：
# DATABASE_URL=mysql+mysqlconnector://root:yourpassword@localhost:3306/book_review_system

# 可选：仅用于 database/init.py 初始化 MySQL（避免把密码写到代码里）
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=yourpassword
# MYSQL_DATABASE=book_review_system

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key

# 邮件配置（可选）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# 日志级别
LOG_LEVEL=INFO